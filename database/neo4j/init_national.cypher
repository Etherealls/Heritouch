// ---- 关系：项目 → 类别 ----
MATCH (h:Heritage), (c:Category)
WHERE h.category = c.name
CREATE (h)-[:BELONGS_TO_CATEGORY]->(c);

// ---- 关系：传承人 → 项目 ----
MATCH (i:Inheritor), (h:Heritage)
WHERE i.project_id = h.id
CREATE (i)-[:INHERITS]->(h);
