# =====================================================================
# Heritouch 后端环境变量示例
# 使用方法：复制为 .env 后按需修改；所有外部依赖均可缺失，
#           缺失时自动降级（SQLite / 内存图谱 / 关键词匹配 / Mock AI），
#           保证服务可无配置启动。
# =====================================================================

# ---------- 应用基础配置 ----------
APP_NAME=Heritouch 地方非遗文化AI解码与传承平台
APP_VERSION=1.0.0
DEBUG=false

# ---------- 数据库 ----------
# MySQL 连接串（docker-compose 中为 mysql+pymysql://root:heritouch@mysql:3306/heritouch?charset=utf8mb4）
# 留空则默认使用 SQLite 本地文件，适合开发环境
DATABASE_URL=
# MySQL 连接失败时是否自动降级为 SQLite（true/false）
SQLITE_FALLBACK=true
# SQLite 降级目标（相对路径基于 server/ 工作目录）
SQLITE_URL=sqlite:///./heritouch.db

# ---------- Neo4j 知识图谱 ----------
# 连接地址（二选一，优先 NEO4J_URL）
NEO4J_URL=
NEO4J_BOLT_URL=bolt://localhost:7687
# 账号密码（两种写法均可）
NEO4J_AUTH=neo4j/password
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---------- AI 文本服务（火山方舟 / 豆包，OpenAI 兼容接口） ----------
# 未配置 AI_API_KEY 或 AI_BASE_URL 时，剧本生成与智能问答自动降级为本地 Mock
# API Key：在火山方舟控制台 https://console.volcengine.com/ark 创建，填入下方 AI_API_KEY
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-2-0-code-preview-260215

# ---------- AI 图像服务（Stable Diffusion API） ----------
# 未配置 IMAGE_API_URL 时，纹样/画作生成返回占位图 URL
IMAGE_API_URL=
IMAGE_API_KEY=

# ---------- RAG 向量库 ----------
# ChromaDB 服务地址（如 http://localhost:8000）；留空使用本地持久化目录
CHROMA_URL=
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ---------- 语音合成（edge / 空） ----------
# edge = Edge-TTS（需安装 edge-tts 且可访问微软服务）；留空返回占位音频信息
TTS_PROVIDER=

# ---------- 安全配置 ----------
# token 签名密钥（生产环境务必修改为随机长字符串）
SECRET_KEY=heritouch-dev-secret-please-change-in-production
# token 有效期（小时）
TOKEN_EXPIRE_HOURS=72

# ---------- Mock 行为 ----------
# AI Mock 生成时是否模拟合理延迟（true/false）
MOCK_DELAY=true
# 静态资源 URL 前缀（占位图等）
STATIC_URL_PREFIX=/static
